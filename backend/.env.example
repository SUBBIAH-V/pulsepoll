# Server Configuration
PORT=8080
ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
# For local MongoDB: mongodb://localhost:27017/pulsepoll
# For MongoDB Atlas Cloud: mongodb+srv://username:password@cluster.mongodb.net/pulsepoll?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/pulsepoll
MONGO_DB_NAME=pulsepoll

# Realtime Cache Configuration (Redis)
# For local Redis: redis://localhost:6379
# For Upstash / Redis Cloud: rediss://default:password@host:port
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret
JWT_SECRET=pulsepoll_jwt_super_secret_key_2026_change_in_production
JWT_EXPIRATION_HOURS=24
